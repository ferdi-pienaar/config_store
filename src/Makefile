CXXFLAGS = -Wall -g -I . -I ../export
# Include some C99 macros that are not part of the C++ standard
CPPFLAGS += -D __STDC_LIMIT_MACROS
CPPFLAGS += -D M_DEFINED_STORE_TYPE=TLV_STORE
#CPPFLAGS += -D M_DEFINED_STORE_TYPE=JSON_STORE
#CXXFLAGS += -save-temps
#CPPFLAGS += -D DEBUG_PRINT
# Generate the .d files when generating objects
CXXFLAGS += -MMD
OBJS = cfg_mgr.o \
cfg_mgr_prt_hexstr.o \
cfg_mgr_setdef_null.o \
cfg_mgr_store.o \
nvram.o \
cfg_mgr_printf.o \
cfg_mgr_descriptor.o \
cfg_mgr_aggregate.o \
cfg_mgr_command.o

OBJS += cfg_mgr_tlv_store.o cfg_mgr_tlv_writer.o cfg_mgr_tlv_loader.o

OBJS += cfg_mgr_json_store.o cfg_mgr_json_writer.o cfg_mgr_json_loader.o cfg_mgr_json_ctxt.o

# -cr means
#  c: create the archive (without this option, if archive doesn't exist, there's a warning)
#  r: insert the files into archive (with replacement)
# We only pass newer prerequisites to the command ($? instead of $^)
libCfgMgr.a: $(OBJS)
	ar cr $@ $?

.PHONY: clean
clean:
	rm -f *.o *.d

# Include the dependencies generated by gcc's MMD option -- see 'Managing Projects with GNU Make'
# But don't include if the target is 'clean'.
# -include means don't print an error message if the .d files don't exist.
ifneq "$(MAKECMDGOALS)" "clean"
-include $(subst .o,.d,$(OBJS))
endif
