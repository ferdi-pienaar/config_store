# To find files that are included by the exported config_manager.h...
CFG_MAN_SRC_DIR = ../src/
CXXFLAGS = -Wall -g -I . -I $(CFG_MAN_SRC_DIR) -I ../export 
#CXXFLAGS += -save-temps 
#CXXFLAGS += -Wl,-Map=output.map # pass option to linker
VPATH = $(CFG_MAN_SRC_DIR) # so make can find the library

test_cfg1: \
$(CFG_MAN_SRC_DIR)config_manager_util.h \
$(CFG_MAN_SRC_DIR)config_manager_setdef_null.h \
../export/config_manager.h \
cfg.o cfg.h my_cfg_fn1.o my_cfg_fn1.h \
-lCfgMan

# cfg.cpp is generated by a script from the corresponding .yaml file
# cfg_id.yaml is optional; depend on it, but only if it exists.
cfg-id-yaml-exists := $(wildcard cfg_id.yaml)
cfg.cpp: cfg.yaml $(cfg-id-yaml-exists)
	python ../code_gen/yaml_code_gen.py $<

.PHONY: clean
clean:
	rm -f *o
	rm cfg.cpp
	rm cfg.h

