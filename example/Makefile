CFG_MGR_SRC_DIR = ../src/
CFG_MGR_UTIL_DIR = ../util/
CXXFLAGS = -Wall -g -I . -I $(CFG_MGR_SRC_DIR) -I $(CFG_MGR_UTIL_DIR) -I ../export
# Generate the .d files when generating objects
CXXFLAGS += -MMD
#CXXFLAGS += -save-temps
#CPPFLAGS += -D DEBUG_PRINT
VPATH = $(CFG_MGR_SRC_DIR) # so make can find the library

OBJS = my_cfg.o my_cfg_fn.o \
$(CFG_MGR_UTIL_DIR)cfg_mgr_set_int.o \
$(CFG_MGR_UTIL_DIR)cfg_mgr_prt_int.o \
$(CFG_MGR_UTIL_DIR)cfg_mgr_set_str.o \
$(CFG_MGR_UTIL_DIR)cfg_mgr_prt_str.o \
$(CFG_MGR_UTIL_DIR)cfg_mgr_strtok.o

test_cfg_mgr: $(OBJS) -lCfgMgr

.PHONY: clean
clean:
	rm -f *.o *.d

# Include the dependencies generated by gcc's MMD option -- see 'Managing Projects with GNU Make'
# But don't include if the target is 'clean'.
# -include means don't print an error message if the .d files don't exist.
ifneq "$(MAKECMDGOALS)" "clean"
-include $(subst .o,.d,$(OBJS))
endif
